# Скопируйте в .env и поменяйте секреты для реального окружения.
# Для локального запуска api из backend/ укажите localhost вместо db.

POSTGRES_USER=cabinet
POSTGRES_PASSWORD=cabinet
POSTGRES_DB=cabinet
DATABASE_URL=postgresql+psycopg://cabinet:cabinet@db:5432/cabinet

JWT_SECRET=dev-secret-change-me-please-use-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440
APP_ENV=dev

# Один пароль для временных демо-пользователей до сидов DS.
DEMO_PASSWORD=demo123

UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE=10485760
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
SEED_ON_STARTUP=true

# Пайплайн проверки заявок (worker).
PIPELINE_MOCKS_URL=http://mocks:8090
PIPELINE_SCORING_URL=http://api:8000
PIPELINE_SPEED=normal

# Ассистент: auto = LLM (Ollama), если задан ASSISTANT_OLLAMA_URL, иначе или при ошибке — правила.
ASSISTANT_MODE=auto
ASSISTANT_OLLAMA_URL=
ASSISTANT_MODEL=qwen2.5:3b-instruct
