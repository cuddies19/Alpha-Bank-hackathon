meta {
  name: Сколько платить в месяц
  type: http
  seq: 2
}

post {
  url: {{api}}/assistant/chat
  body: json
  auth: bearer
}

auth:bearer {
  token: {{igorToken}}
}

body:json {
  {
    "message": "Сколько я буду платить в месяц по кредиту 3 млн на 18 месяцев?"
  }
}

assert {
  res.status: eq 200
  res.body.message: isString
}

docs {
  Вопрос ассистенту: «Сколько я буду платить в месяц по кредиту 3 млн на 18 месяцев?».
}
