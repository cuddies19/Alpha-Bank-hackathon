meta {
  name: Вход Марина
  type: http
  seq: 3
}

post {
  url: {{api}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "login": "marina.orlova",
    "password": "demo123"
  }
}

assert {
  res.status: eq 200
  res.body.access_token: isString
}

script:post-response {
  bru.setVar("marinaToken", res.body.access_token);
}

docs {
  Вход как Марина (marina.orlova). Токен сохраняется в переменную marinaToken.
}
