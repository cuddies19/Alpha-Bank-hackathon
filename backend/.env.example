# Postgres connection string (local run from backend/).
DATABASE_URL=postgresql+psycopg://cabinet:cabinet@localhost:5432/cabinet
# Base URL of the mocks service.
PIPELINE_MOCKS_URL=http://localhost:8090
# DS scoring base URL; empty = stub (640 / B).
PIPELINE_SCORING_URL=
# normal = 5 s pause between stages, fast = 1 s.
PIPELINE_SPEED=normal
# Assistant: auto = LLM if ASSISTANT_OLLAMA_URL is set, rules otherwise or on any LLM error.
ASSISTANT_MODE=auto
ASSISTANT_OLLAMA_URL=
ASSISTANT_MODEL=qwen2.5:3b-instruct
